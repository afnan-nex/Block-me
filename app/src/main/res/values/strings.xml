<resources>
    <string name="app_name">Block me</string>
    <string name="app_tagline">Master Your Focus</string>

    <!-- Accessibility Service -->
    <string name="accessibility_service_description">Block me uses the Accessibility Service to detect when you press Home, Back, or Recent Apps during a lockdown session. When detected, your screen is locked immediately to prevent distraction. This service does NOT read any personal data, text, or content from your apps.</string>
    <string name="accessibility_service_label">Block me Lockdown</string>

    <!-- Device Admin -->
    <string name="device_admin_description">Block me requires Device Administrator permission to lock your screen when you attempt to navigate away during a focus session. This is the core feature that makes distraction impossible.</string>

    <!-- Permissions -->
    <string name="perm_overlay_title">Display Over Other Apps</string>
    <string name="perm_overlay_desc">Required to show the fullscreen lockdown timer above all other apps during a focus session.</string>
    <string name="perm_accessibility_title">Accessibility Service</string>
    <string name="perm_accessibility_desc">Required to detect Home, Back, and Recent Apps presses and lock your screen immediately.</string>
    <string name="perm_device_admin_title">Device Admin — Required / Must</string>
    <string name="perm_device_admin_desc">Required to lock the screen when a blocked action is detected. Without this, the core lockdown cannot function.</string>
    <string name="perm_battery_title">Ignore Battery Optimizations</string>
    <string name="perm_battery_desc">Required to keep the focus timer running reliably in the background without being killed by the system.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_desc">Required to show the ongoing focus session notification with remaining time.</string>
    <string name="perm_alarm_title">Exact Alarms</string>
    <string name="perm_alarm_desc">Required for scheduled focus sessions to start at the exact configured time.</string>

